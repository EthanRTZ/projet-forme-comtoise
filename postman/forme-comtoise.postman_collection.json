{
  "info": {
    "name": "Forme Comtoise",
    "_postman_id": "4dfb2e73-e80e-4e1f-9a0d-formecomtoise",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key": "baseUrl", "value": "http://localhost:3000"}, {"key": "memberId", "value": "1"}, {"key": "sessionId", "value": "1"}, {"key": "reportId", "value": ""}],
  "item": [
    {"name": "Santé", "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/health"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Clubs", "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/clubs"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Formules", "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/formules"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Planning", "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/clubs/1/planning?debut=2025-09-01"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Fiche adhérent", "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/adherents/{{memberId}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Réserver", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"adherentId\": {{memberId}}}"}, "url": "{{baseUrl}}/seances/{{sessionId}}/reservations"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('201 ou 409', () => pm.expect([201,409]).to.include(pm.response.code));"]}}]},
    {"name": "Statistique remplissage", "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/statistiques/remplissage?debut=2025-09-01&fin=2026-08-31"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Statistique coachs", "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/statistiques/coachs"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Demander rapport", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"debut\":\"2025-09-01\",\"fin\":\"2026-08-31\"}"}, "url": "{{baseUrl}}/rapports"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('202', () => pm.response.to.have.status(202));", "pm.collectionVariables.set('reportId', pm.response.json().id);"]}}]},
    {"name": "Suivre le rapport", "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/rapports/{{reportId}}"}, "event": [{"listen": "test", "script": {"exec": ["const r = pm.response.json();", "pm.test('statut connu', () => pm.expect(['en_attente','en_cours','termine','echec']).to.include(r.statut));", "if (r.statut === 'en_attente' || r.statut === 'en_cours') { pm.execution.setNextRequest('Suivre le rapport'); }"]}}]},
    {"name": "Télécharger le rapport", "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/rapports/{{reportId}}/pdf"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('200 ou 409', () => pm.expect([200,409]).to.include(pm.response.code));"]}}]}
  ]
}
